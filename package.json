{
  "name": "agentready",
  "version": "0.1.0",
  "private": true,
  "description": "AgentReady - the open standard for agent readiness",
  "license": "MIT",
  "scripts": {
    "dev": "command -v portless >/dev/null || npm install -g portless && portless run --name agentready next dev",
    "prebuild": "node scripts/check-spec.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:spec": "node scripts/check-spec.mjs",
    "sync:spec": "node scripts/sync-spec.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4.1.14",
    "typescript": "^5"
  }
}
